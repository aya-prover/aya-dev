prim I : ISet
prim Cof : Set
prim Partial (φ : Cof) (A : Type) : Set
module cof-operators {
  prim cofAnd (φ ψ : Cof) : Cof
  prim cofOr (φ ψ : Cof) : Cof
  prim cofEq (i j : I) : Cof
}
public open cof-operators using
  ( cofAnd as infixl ∧f
  , cofOr as infixl ∨f
  , cofEq as infix =f)
prim hcom (A : Type) (r s : I) (φ : Cof) (u : Fn (i : I) -> Partial (φ ∨f (i =f r)) A) : A
prim unPartial (A : Type) (u : Partial (1 =f 1) A) : A
